FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS clearra-build

ARG CLEARRA_SOURCE_COMMIT
ARG CLEARRA_ENGINE_BUILD_ID
ENV CLEARRA_SOURCE_COMMIT=${CLEARRA_SOURCE_COMMIT}
ENV CLEARRA_ENGINE_BUILD_ID=${CLEARRA_ENGINE_BUILD_ID}
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tools ./tools
COPY assets ./assets
RUN printf '%s\n' "${CLEARRA_SOURCE_COMMIT}" | grep -Eq '^[0-9a-f]{40}$' \
    && test "${CLEARRA_ENGINE_BUILD_ID}" = "${CLEARRA_SOURCE_COMMIT}"
RUN cargo build \
      --locked \
      --release \
      --package clearra-cli \
      --features wasm-cpu-runtime,webgpu-search \
    && output="$(/workspace/target/release/clearra --format json rules list)" \
    && printf '%s' "${output}" | grep -Fq "\"source_commit\":\"${CLEARRA_SOURCE_COMMIT}\"" \
    && printf '%s' "${output}" | grep -Fq "\"engine_build_id\":\"${CLEARRA_ENGINE_BUILD_ID}\"" \
    && printf '%s' "${output}" | grep -Fq '"contract_schema_version":"clearra.search.contract.v2"' \
    && printf '%s' "${output}" | grep -Fq '"supply_semantics_id":"clearra.supply.projected-terminal-lookahead.v1"' \
    && printf '%s' "${output}" | grep -Fq '"artifact_schema_version":"clearra.solution-data.v1"' \
    && /workspace/target/release/clearra \
      --format json pc --lines 2 --queue IJLOO --fixed --no-hold >/dev/null
RUN output="$(/workspace/target/release/clearra \
      finesse search --base-mask 0 --target-mask 0xf --height 1 \
      --queue I --no-hold --pattern-knowledge oracle --rule srs-plus \
      --workers 1 --format json)" \
    && echo "${output}" | grep -q '"mode":"search"'
RUN output="$(/workspace/target/release/clearra \
      finesse score --initial-mask 0 --height 4 \
      --placements O:spawn:4:0 --queue O --no-hold \
      --pattern-knowledge both --rule srs-plus --workers 1 --format json)" \
    && echo "${output}" | grep -q '"mode":"score"'

FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS node-build

WORKDIR /workspace
COPY . .
RUN corepack enable \
    && corepack prepare pnpm@11.5.0 --activate \
    && test "$(pnpm --version)" = "11.5.0"
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter ctk3 run build
RUN pnpm deploy --filter @clearra/discord-bot --prod /workspace/discord-runtime

FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS runtime

ARG CLEARRA_SOURCE_COMMIT
ARG CLEARRA_ENGINE_BUILD_ID
ARG CLEARRA_SEARCH_CONTRACT_REVISION=clearra.search.contract.v2
ARG CLEARRA_SUPPLY_SEMANTICS_ID=clearra.supply.projected-terminal-lookahead.v1
ARG CLEARRA_ARTIFACT_SCHEMA_VERSION=clearra.solution-data.v1

ENV NODE_ENV=production
ENV PORT=8080
ENV CLEARRA_EXECUTABLE=/usr/local/bin/clearra
ENV CLEARRA_SOURCE_COMMIT=${CLEARRA_SOURCE_COMMIT}
ENV CLEARRA_ENGINE_BUILD_ID=${CLEARRA_ENGINE_BUILD_ID}
ENV CLEARRA_SEARCH_CONTRACT_REVISION=${CLEARRA_SEARCH_CONTRACT_REVISION}
ENV CLEARRA_SUPPLY_SEMANTICS_ID=${CLEARRA_SUPPLY_SEMANTICS_ID}
ENV CLEARRA_ARTIFACT_SCHEMA_VERSION=${CLEARRA_ARTIFACT_SCHEMA_VERSION}
WORKDIR /app

RUN node -e "const p=/^[0-9a-f]{40}$/; if(!p.test(process.env.CLEARRA_SOURCE_COMMIT||'')||process.env.CLEARRA_ENGINE_BUILD_ID!==process.env.CLEARRA_SOURCE_COMMIT||process.env.CLEARRA_SEARCH_CONTRACT_REVISION!=='clearra.search.contract.v2'||process.env.CLEARRA_SUPPLY_SEMANTICS_ID!=='clearra.supply.projected-terminal-lookahead.v1'||process.env.CLEARRA_ARTIFACT_SCHEMA_VERSION!=='clearra.solution-data.v1') process.exit(1)"

COPY --from=clearra-build /workspace/target/release/clearra /usr/local/bin/clearra
COPY --from=node-build /workspace/discord-runtime/ ./

RUN node --input-type=module -e "await import('./src/clearra/command.mjs'); await import('./src/job-service/server.mjs'); await import('./scripts/run-cloud-candidate-smoke-job.mjs')"

USER node
EXPOSE 8080
CMD ["node", "./src/job-service/main.mjs"]
