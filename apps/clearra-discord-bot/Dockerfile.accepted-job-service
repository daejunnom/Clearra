# No Rust toolchain or CTK3 compilation in the production packaging route.
FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS accepted-inputs

ARG CLEARRA_SOURCE_COMMIT
ARG CLEARRA_ENGINE_BUILD_ID
ARG CLEARRA_PRODUCT_VERSION
ARG CLEARRA_ACCEPTED_RUN_ID
ARG CLEARRA_ACCEPTED_RUN_ATTEMPT
ARG CLEARRA_CLI_SHA256
WORKDIR /workspace
COPY source/ ./
# Keep runtime dependency installation separate from product compilation.
RUN corepack enable \
    && corepack prepare pnpm@11.5.0 --activate \
    && test "$(pnpm --version)" = "11.5.0" \
    && pnpm install --prod --frozen-lockfile --ignore-scripts
COPY inputs/ctk3/ ./packages/ctk3/dist/
COPY inputs/clearra /usr/local/bin/clearra
RUN chmod 0755 /usr/local/bin/clearra \
    && printf '%s  %s\n' "$CLEARRA_CLI_SHA256" /usr/local/bin/clearra | sha256sum --check --strict \
    && node scripts/tools/accepted-ctk3-dist.mjs \
      --verify packages/ctk3/dist --expected-source-commit "$CLEARRA_SOURCE_COMMIT" \
      --expected-run-id "$CLEARRA_ACCEPTED_RUN_ID" --expected-run-attempt "$CLEARRA_ACCEPTED_RUN_ATTEMPT" \
    && mkdir -p dist \
    && cp /usr/local/bin/clearra "dist/Clearra-CLI-v${CLEARRA_PRODUCT_VERSION}-linux-x86_64" \
    && node scripts/tools/verify-linux-cli-runtime.mjs \
      --version "$CLEARRA_PRODUCT_VERSION" --source-commit "$CLEARRA_SOURCE_COMMIT" \
    && pnpm deploy --filter @clearra/discord-bot --prod /workspace/discord-runtime
RUN output="$(/usr/local/bin/clearra finesse score --initial-mask 0 --height 4 \
      --placements O:spawn:4:0 --queue O --no-hold --pattern-knowledge both \
      --rule srs-plus --workers 1 --format json)" \
    && printf '%s' "$output" | node --input-type=module -e \
      "import{readFileSync}from'node:fs';const r=JSON.parse(readFileSync(0,'utf8'));if(r.finesse_report?.mode!=='score')process.exit(1)"

FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS runtime

ARG CLEARRA_SOURCE_COMMIT
ARG CLEARRA_ENGINE_BUILD_ID
ARG CLEARRA_CLI_SHA256
ARG CLEARRA_PRODUCT_VERSION
ENV NODE_ENV=production
ENV PORT=8080
ENV CLEARRA_EXECUTABLE=/usr/local/bin/clearra
ENV CLEARRA_LEGAL_BOARD_DIRECTORY=/opt/clearra/accelerators/legal-board
ENV CLEARRA_CONDITIONED_REACHABILITY_DIRECTORY=/opt/clearra/accelerators/conditioned-reachability
ENV CLEARRA_SOURCE_COMMIT=${CLEARRA_SOURCE_COMMIT}
ENV CLEARRA_ENGINE_BUILD_ID=${CLEARRA_ENGINE_BUILD_ID}
ENV CLEARRA_SEARCH_CONTRACT_REVISION=clearra.search.contract.v2
ENV CLEARRA_SUPPLY_SEMANTICS_ID=clearra.supply.projected-terminal-lookahead.v1
ENV CLEARRA_ARTIFACT_SCHEMA_VERSION=clearra.solution-data.v1
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl --version | grep -q 'Protocols:.*https' \
    && curl --version | grep -q 'Features:.*HTTP2'
RUN node -e "const p=/^[0-9a-f]{40}$/;if(!p.test(process.env.CLEARRA_SOURCE_COMMIT||'')||process.env.CLEARRA_ENGINE_BUILD_ID!==process.env.CLEARRA_SOURCE_COMMIT)process.exit(1)"
COPY --from=accepted-inputs /usr/local/bin/clearra /usr/local/bin/clearra
COPY --from=accepted-inputs /workspace/discord-runtime/ ./
RUN printf '%s  %s\n' "$CLEARRA_CLI_SHA256" /usr/local/bin/clearra | sha256sum --check --strict \
    && node --input-type=module -e "await import('./src/clearra/command.mjs');await import('./src/job-service/server.mjs');await import('./scripts/run-cloud-candidate-smoke-job.mjs')"
RUN node ./scripts/provision-v081-accelerators.mjs provision "$CLEARRA_PRODUCT_VERSION" \
      /usr/local/bin/clearra /opt/clearra/accelerators \
    && if test -d /opt/clearra/accelerators; then chmod -R a-w /opt/clearra/accelerators; fi
USER node
RUN node ./scripts/provision-v081-accelerators.mjs verify "$CLEARRA_PRODUCT_VERSION" \
      /usr/local/bin/clearra /opt/clearra/accelerators
EXPOSE 8080
CMD ["node", "./src/job-service/main.mjs"]
