FROM node:22-bookworm-slim AS clearra-cli

ARG CLEARRA_VERSION
ARG CLEARRA_CLI_SHA256

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 5 --retry-delay 2 \
      "https://github.com/daejunnom/Clearra/releases/download/v${CLEARRA_VERSION}/Clearra-CLI-v${CLEARRA_VERSION}-linux-x86_64" \
      --output /usr/local/bin/clearra \
    && chmod 0755 /usr/local/bin/clearra \
    && echo "${CLEARRA_CLI_SHA256}  /usr/local/bin/clearra" | sha256sum --check --strict \
    && /usr/local/bin/clearra --format json rules list >/dev/null
RUN output="$(/usr/local/bin/clearra \
      finesse search --base-mask 0 --target-mask 0xf --height 1 \
      --queue I --no-hold --pattern-knowledge oracle --rule srs-plus \
      --workers 1 --format json)" \
    && echo "${output}" | grep -q '"mode":"search"'
RUN output="$(/usr/local/bin/clearra \
      finesse score --initial-mask 0 --height 4 \
      --placements O:spawn:4:0 --queue O --no-hold \
      --pattern-knowledge both --rule srs-plus --workers 1 --format json)" \
    && echo "${output}" | grep -q '"mode":"score"'

FROM node:22-bookworm-slim AS runtime

ARG CLEARRA_SOURCE_COMMIT
ARG CLEARRA_ENGINE_BUILD_ID
ARG CLEARRA_SEARCH_CONTRACT_REVISION=clearra.search.contract.legacy-v1
ARG CLEARRA_SUPPLY_SEMANTICS_ID=clearra.supply.legacy-v1
ARG CLEARRA_ARTIFACT_SCHEMA_VERSION=clearra.solution-data.legacy-v1

ENV NODE_ENV=production
ENV PORT=8080
ENV CLEARRA_EXECUTABLE=/usr/local/bin/clearra
ENV CLEARRA_SOURCE_COMMIT=${CLEARRA_SOURCE_COMMIT}
ENV CLEARRA_ENGINE_BUILD_ID=${CLEARRA_ENGINE_BUILD_ID}
ENV CLEARRA_SEARCH_CONTRACT_REVISION=${CLEARRA_SEARCH_CONTRACT_REVISION}
ENV CLEARRA_SUPPLY_SEMANTICS_ID=${CLEARRA_SUPPLY_SEMANTICS_ID}
ENV CLEARRA_ARTIFACT_SCHEMA_VERSION=${CLEARRA_ARTIFACT_SCHEMA_VERSION}
WORKDIR /app

RUN node -e "const p=/^[0-9a-f]{40}$/; if(!p.test(process.env.CLEARRA_SOURCE_COMMIT||'')||!p.test(process.env.CLEARRA_ENGINE_BUILD_ID||'')||process.env.CLEARRA_SEARCH_CONTRACT_REVISION!=='clearra.search.contract.legacy-v1'||process.env.CLEARRA_SUPPLY_SEMANTICS_ID!=='clearra.supply.legacy-v1'||process.env.CLEARRA_ARTIFACT_SCHEMA_VERSION!=='clearra.solution-data.legacy-v1') process.exit(1)"

COPY --from=clearra-cli /usr/local/bin/clearra /usr/local/bin/clearra
COPY apps/clearra-discord-bot/src/clearra ./clearra
COPY apps/clearra-discord-bot/src/job-service ./job-service
COPY apps/clearra-discord-bot/src/operational-log.mjs ./operational-log.mjs

USER node
EXPOSE 8080
CMD ["node", "./job-service/main.mjs"]
