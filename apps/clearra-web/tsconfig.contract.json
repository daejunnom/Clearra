{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "test/*.contract.ts"
  ],
  "files": [
    "../../scripts/types/node-contract-builtins.d.ts"
  ]
}
