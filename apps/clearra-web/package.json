{
  "name": "@clearra/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "svelte-kit sync",
    "wasm:build": "node ../../scripts/tools/build-clearra-wasm.mjs --environment native",
    "wasm:build:wsl": "node ../../scripts/tools/build-clearra-wasm.mjs --environment wsl",
    "predev": "npm run sync && npm run wasm:build",
    "dev": "vite --host 127.0.0.1",
    "dev:wsl": "npm run sync && npm run wasm:build:wsl && vite --host 127.0.0.1",
    "prebuild": "npm run sync && npm run wasm:build",
    "build": "vite build",
    "build:wsl": "npm run sync && npm run wasm:build:wsl && vite build"
  },
  "dependencies": {
    "@clearra/ui": "0.1.0",
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "vite": "^6.0.0"
  }
}
