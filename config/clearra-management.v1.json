{
  "schema_id": "clearra.management-policy.v2",
  "policy_version": 2,
  "canonical_source": "config/clearra-management.v1.json",
  "managed_scope": [
    "generated-output-paths",
    "process-memory",
    "process-tree",
    "wsl-lifecycle"
  ],
  "excluded_scope": [
    "filesystem-reading",
    "git",
    "dependency-management",
    "toolchain-installation",
    "package-publishing",
    "general-process-registration"
  ],
  "toolchains": {
    "node": "22.23.2",
    "npm": "10.9.8",
    "pnpm": "11.5.0",
    "rust": "1.98.1",
    "cargo": "1.98.1",
    "wasm_bindgen": "0.2.126"
  },
  "toolchain_sources": {
    "node": {
      "source": "release-artifact",
      "release_run_id": 35508135887,
      "commit": "6618142e4fe8452985ae3ee94a595f33f410fde6",
      "release_version_evidence_sha256": "bab3f801b89c12dbbafcaace19d6df82cc14a535823b065517769465f852ec33",
      "official_shasums_url": "https://nodejs.org/dist/v22.23.2/SHASUMS256.txt",
      "distribution_sha256": {
        "linux-x64.tar.gz": "b294a556e639d64338823920e5866c21c02741742d2e1529ee1a225c1ec9252a",
        "linux-x64.tar.xz": "d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307",
        "win-x64.zip": "1177b4137ba5adaa56354ae40f1080c7450e8ae09cecb47da459d1c52ac99f97",
        "x64.msi": "ce9572ae220c345fbae2340bbb4d084e8ca5e0fe093ee7067d43094ae23be989"
      }
    },
    "npm": {
      "source": "canonical-node-distribution",
      "independent_upgrade": false
    },
    "pnpm": {
      "source": "corepack",
      "activation": "pnpm@11.5.0"
    },
    "rust": {
      "source": "rustup-exact-toolchain",
      "channel": "1.98.1",
      "profile": "minimal"
    },
    "cargo": {
      "source": "bundled-with-rust-1.98.1"
    },
    "wasm_bindgen": {
      "source": "cargo-install-locked",
      "managed_root": "build/tools/cargo/wasm-bindgen-cli/0.2.126/<platform>"
    }
  },
  "repository_roots": [
    {
      "id": "build-publication",
      "path": "build",
      "classes": [
        "build-cache",
        "publication",
        "container-stage",
        "package-output",
        "tool-binary"
      ],
      "lifecycle": "reproducible-until-explicit-clean",
      "owners": [
        "cargo",
        "frontend",
        "wasm",
        "discord-container",
        "release-evidence",
        "management"
      ]
    },
    {
      "id": "coverage",
      "path": "coverage",
      "classes": [
        "coverage"
      ],
      "lifecycle": "ephemeral-until-explicit-clean",
      "owners": [
        "cargo"
      ]
    },
    {
      "id": "local-artifacts",
      "path": "_local/artifacts",
      "classes": [
        "test",
        "benchmark",
        "analysis",
        "research"
      ],
      "lifecycle": "retained-run-evidence",
      "owners": [
        "cargo",
        "frontend",
        "wasm",
        "ctk3",
        "discord-container",
        "benchmark",
        "browser",
        "management"
      ]
    },
    {
      "id": "local-state",
      "path": "_local/state",
      "classes": [
        "receipt",
        "lock",
        "checkpoint"
      ],
      "lifecycle": "transaction-state-until-receipted-clean",
      "owners": [
        "management"
      ]
    },
    {
      "id": "local-temp",
      "path": "_local/tmp",
      "classes": [
        "temporary"
      ],
      "lifecycle": "process-lifetime",
      "owners": [
        "management"
      ]
    },
    {
      "id": "dependency-links",
      "path": "node_modules",
      "classes": [
        "pnpm-links"
      ],
      "lifecycle": "frozen-install-link-view",
      "owners": [
        "management"
      ]
    },
    {
      "id": "desktop-dependency-links",
      "path": "apps/clearra-desktop/node_modules",
      "classes": [
        "pnpm-links"
      ],
      "lifecycle": "frozen-install-link-view",
      "owners": [
        "management"
      ]
    },
    {
      "id": "discord-dependency-links",
      "path": "apps/clearra-discord-bot/node_modules",
      "classes": [
        "pnpm-links"
      ],
      "lifecycle": "frozen-install-link-view",
      "owners": [
        "management"
      ]
    },
    {
      "id": "web-dependency-links",
      "path": "apps/clearra-web/node_modules",
      "classes": [
        "pnpm-links"
      ],
      "lifecycle": "frozen-install-link-view",
      "owners": [
        "management"
      ]
    },
    {
      "id": "ui-dependency-links",
      "path": "packages/clearra-ui/node_modules",
      "classes": [
        "pnpm-links"
      ],
      "lifecycle": "frozen-install-link-view",
      "owners": [
        "management"
      ]
    },
    {
      "id": "ctk3-dependency-links",
      "path": "packages/ctk3/node_modules",
      "classes": [
        "pnpm-links"
      ],
      "lifecycle": "frozen-install-link-view",
      "owners": [
        "management"
      ]
    },
    {
      "id": "ctk3-package",
      "path": "packages/ctk3/dist",
      "classes": [
        "package-output"
      ],
      "lifecycle": "reproducible-package-output",
      "owners": [
        "ctk3"
      ]
    },
    {
      "id": "web-public-wasm",
      "path": "apps/clearra-web/static/wasm",
      "classes": [
        "publication"
      ],
      "lifecycle": "reproducible-publication",
      "owners": [
        "wasm"
      ]
    },
    {
      "id": "web-export",
      "path": "apps/clearra-web/build",
      "classes": [
        "publication"
      ],
      "lifecycle": "reproducible-publication",
      "owners": [
        "frontend"
      ]
    },
    {
      "id": "desktop-export",
      "path": "apps/clearra-desktop/build",
      "classes": [
        "publication"
      ],
      "lifecycle": "reproducible-publication",
      "owners": [
        "frontend"
      ]
    }
  ],
  "external_roots": [
    {
      "id": "build-cache",
      "windows": "${LOCALAPPDATA}/Clearra/build",
      "linux": "${XDG_CACHE_HOME:-${HOME}/.cache}/Clearra/build",
      "lifecycle": "clearra-owned-receipted-clean-only"
    },
    {
      "id": "cache",
      "windows": "${LOCALAPPDATA}/Clearra/cache",
      "linux": "${XDG_CACHE_HOME:-${HOME}/.cache}/Clearra/cache",
      "lifecycle": "clearra-owned-receipted-clean-only"
    },
    {
      "id": "state",
      "windows": "${LOCALAPPDATA}/Clearra/state",
      "linux": "${XDG_STATE_HOME:-${HOME}/.local/state}/Clearra",
      "lifecycle": "clearra-owned-receipted-clean-only"
    },
    {
      "id": "logs",
      "windows": "${LOCALAPPDATA}/Clearra/logs",
      "linux": "${XDG_STATE_HOME:-${HOME}/.local/state}/Clearra/logs",
      "lifecycle": "clearra-owned-receipted-clean-only"
    },
    {
      "id": "browser",
      "windows": "${LOCALAPPDATA}/Clearra/browser",
      "linux": "${XDG_STATE_HOME:-${HOME}/.local/state}/Clearra/browser",
      "lifecycle": "clearra-owned-receipted-clean-only"
    },
    {
      "id": "temporary",
      "windows": "${LOCALAPPDATA}/Clearra/tmp",
      "linux": "${XDG_RUNTIME_DIR:-/tmp}/Clearra",
      "lifecycle": "process-lifetime-receipted-clean-only"
    },
    {
      "id": "wsl-runtime",
      "windows": "${LOCALAPPDATA}/Clearra/wsl",
      "linux": "${XDG_STATE_HOME:-${HOME}/.local/state}/Clearra/wsl",
      "lifecycle": "dedicated-runtime-explicit-lifecycle"
    }
  ],
  "forbidden_repository_roots": [
    "target",
    "dist",
    "dist-server",
    ".cache",
    "models",
    "checkpoints"
  ],
  "secret_path_patterns": [
    ".env",
    ".env.*",
    "*.key",
    "*.pem",
    "*.ppk",
    "id_rsa*",
    "id_dsa*",
    "id_ecdsa*",
    "id_ed25519*",
    ".npmrc",
    ".pypirc",
    "*credential*",
    "*credentials*",
    "*api-key*",
    "*apikey*",
    "*private-key*",
    "*private_key*",
    "*service-account*.json",
    "*service_account*.json"
  ],
  "override_policy": {
    "flag": "--force-unmanaged-output",
    "reason_flag": "--force-reason",
    "local_tty_only": true,
    "prohibited_contexts": [
      "ci",
      "release",
      "deployment",
      "non-interactive",
      "git-ref-change",
      "lockfile-mismatch",
      "credential-path",
      "symlink-or-junction-escape"
    ],
    "recommendation": "not-recommended"
  },
  "resource_profiles": {
    "control": {
      "minimum_memory_mib": 256,
      "maximum_memory_mib": 512,
      "timeout_seconds": 300,
      "maximum_timeout_seconds": 300,
      "termination_grace_seconds": 5,
      "maximum_descendant_processes": 32,
      "output_limit_bytes": 16777216,
      "hard_containment_required": false,
      "oom_policy": "fail-no-retry",
      "admission_basis": "runtime-pressure",
      "start_admission": "critical-reserve",
      "memory_pressure_action": "gc-then-fail-close",
      "concurrency_class": "control"
    },
    "build-test": {
      "minimum_memory_mib": 3072,
      "maximum_memory_mib": 6144,
      "timeout_seconds": 5400,
      "maximum_timeout_seconds": 5400,
      "termination_grace_seconds": 10,
      "maximum_descendant_processes": 512,
      "output_limit_bytes": 67108864,
      "hard_containment_required": false,
      "oom_policy": "fail-no-retry",
      "admission_basis": "runtime-pressure",
      "start_admission": "critical-reserve",
      "memory_pressure_action": "gc-then-fail-close",
      "concurrency_class": "memory-intensive"
    },
    "verification": {
      "minimum_memory_mib": 768,
      "maximum_memory_mib": 2048,
      "timeout_seconds": 5400,
      "maximum_timeout_seconds": 5400,
      "termination_grace_seconds": 10,
      "maximum_descendant_processes": 512,
      "output_limit_bytes": 67108864,
      "hard_containment_required": false,
      "oom_policy": "fail-no-retry",
      "admission_basis": "runtime-pressure",
      "start_admission": "critical-reserve",
      "memory_pressure_action": "gc-then-fail-close",
      "concurrency_class": "memory-intensive"
    },
    "benchmark-search": {
      "minimum_memory_mib": 4096,
      "maximum_memory_mib": null,
      "timeout_seconds": 7200,
      "maximum_timeout_seconds": 7200,
      "termination_grace_seconds": 10,
      "maximum_descendant_processes": 256,
      "output_limit_bytes": 134217728,
      "hard_containment_required": false,
      "oom_policy": "fail-no-retry",
      "explicit_timeout_required": true,
      "admission_basis": "runtime-pressure",
      "start_admission": "critical-reserve",
      "memory_pressure_action": "gc-then-fail-close",
      "concurrency_class": "memory-intensive"
    },
    "local-service": {
      "minimum_memory_mib": 512,
      "maximum_memory_mib": 2048,
      "timeout_seconds": 7200,
      "maximum_timeout_seconds": 7200,
      "termination_grace_seconds": 10,
      "maximum_descendant_processes": 64,
      "output_limit_bytes": 33554432,
      "hard_containment_required": false,
      "oom_policy": "fail-no-retry",
      "explicit_lease_required": true,
      "admission_basis": "runtime-pressure",
      "start_admission": "critical-reserve",
      "memory_pressure_action": "gc-then-fail-close",
      "concurrency_class": "local-service"
    },
    "cloud-job": {
      "minimum_memory_mib": 16384,
      "maximum_memory_mib": 16384,
      "timeout_seconds": 840,
      "maximum_timeout_seconds": 900,
      "termination_grace_seconds": 10,
      "maximum_descendant_processes": 64,
      "output_limit_bytes": 67108864,
      "hard_containment_required": true,
      "oom_policy": "fail-no-retry",
      "cpu_count": 8,
      "concurrency": 1,
      "maximum_jobs": 1,
      "admission_basis": "runtime-pressure",
      "start_admission": "critical-reserve",
      "memory_pressure_action": "gc-then-fail-close",
      "concurrency_class": "cloud-job"
    }
  },
  "runtime_policy": {
    "memory_pressure": {
      "sample_interval_seconds": 2.0,
      "recovery_grace_seconds": 2.0,
      "physical_reserve_mib": 512,
      "physical_reserve_fraction": 0.03125,
      "commit_reserve_mib": 1024,
      "commit_reserve_fraction": 0.03125,
      "critical_physical_reserve_mib": 128,
      "critical_commit_reserve_mib": 256,
      "cooperative_gc_protocol": "clearra.memory-pressure.v1",
      "request_cooperative_full_gc": true,
      "require_ack_for_child_full_gc_claim": true,
      "automatic_retry": false
    },
    "parallel_admission": {
      "stale_slot_grace_seconds": 30,
      "classes": {
        "control": {
          "maximum_parallel": 2
        },
        "memory-intensive": {
          "maximum_parallel": 1
        },
        "local-service": {
          "maximum_parallel": 1
        },
        "cloud-job": {
          "maximum_parallel": 1
        }
      }
    },
    "process_tree_contract": {
      "windows_job_kill_on_close": true,
      "windows_aggregate_memory_limit": true,
      "windows_active_process_limit": true,
      "linux_process_group": true,
      "wsl_terminate_distribution": "Clearra-Build",
      "wsl_global_shutdown_allowed": false
    },
    "local_ports": {
      "4194": {
        "role": "local-product-test",
        "profiles": [
          "local-service"
        ],
        "persistent": true
      },
      "4195": {
        "role": "local-benchmark-ab",
        "profiles": [
          "local-service",
          "benchmark-search"
        ],
        "persistent": false,
        "strict_port": true
      },
      "8790": {
        "role": "discord-bot-management",
        "profiles": [
          "local-service"
        ],
        "persistent": true,
        "transport": "ssh-local-forward"
      }
    },
    "wsl": {
      "distribution": "Clearra-Build",
      "source_distribution": "Ubuntu",
      "marker": "/etc/clearra/runtime.json",
      "allow_shutdown": false,
      "terminate_only_dedicated_distribution": true,
      "entrypoints": {
        "verify": {
          "profile": "control",
          "requires_source": false
        },
        "sync-workspace": {
          "profile": "build-test",
          "requires_source": true
        },
        "wasm-build": {
          "profile": "build-test",
          "requires_source": true,
          "output_path_options": [
            "--staging"
          ]
        },
        "core-c-tests": {
          "profile": "build-test",
          "requires_source": true
        },
        "oracle-local-layers-v080": {
          "profile": "build-test",
          "requires_source": false,
          "output_path_options": [
            "--output"
          ],
          "input_path_options": [
            "--accepted-ctk3"
          ]
        },
        "pc-runtime-build-batch": {
          "profile": "benchmark-search",
          "requires_source": true,
          "timeout_seconds": 7200,
          "output_path_options": [
            "--host-output"
          ]
        },
        "fixture-normal": {
          "profile": "control",
          "requires_source": false
        },
        "fixture-nonzero": {
          "profile": "control",
          "requires_source": false
        },
        "fixture-timeout": {
          "profile": "control",
          "requires_source": false,
          "timeout_seconds": 5
        },
        "fixture-oom": {
          "profile": "control",
          "requires_source": false
        },
        "fixture-tree": {
          "profile": "control",
          "requires_source": false,
          "timeout_seconds": 5
        },
        "posix-syntax-audit": {
          "profile": "control",
          "requires_source": false
        },
        "native-cargo": {
          "profile": "build-test",
          "requires_source": true
        }
      }
    }
  }
}
