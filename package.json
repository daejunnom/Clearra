{
  "name": "clearra-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.5.0"
  },
  "scripts": {
    "build:ctk3": "pnpm --filter ctk3 run build",
    "management:build": "cargo build --locked -p clearra-manage --release",
    "management:verify": "cargo run --locked -p clearra-manage -- runtime audit",
    "management:test": "cargo test --locked -p clearra-manage"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "esbuild": "^0.25.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  }
}
