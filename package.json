{
  "name": "clearra-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.5.0"
  },
  "scripts": {
    "build:ctk3": "pnpm --filter ctk3 run build",
    "management:verify": "python -B scripts/management/clearra_manage.py deps verify",
    "management:test": "python -B -m unittest discover -s scripts/management/tests -v"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "esbuild": "^0.25.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  }
}
