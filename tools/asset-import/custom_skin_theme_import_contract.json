{
  "schema_version": 1,
  "kind": "custom-skin-theme-import-contract",
  "skin_id": "required",
  "palette_id": "required",
  "piece_mapping": "required-all-standard-pieces",
  "grid_style": "required",
  "background": "required",
  "line_clear_highlight": "required",
