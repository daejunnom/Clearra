index 0000000..b4d7e0c
--- /dev/null
+++ b/packages/clearra-ui/src/lib/workspace/RecoveryFieldEditor.svelte
@@ -0,0 +1,60 @@
+<script lang="ts">
+  import { createEventDispatcher } from 'svelte';
+  import WorkspaceBoardEditor from './WorkspaceBoardEditor.svelte';
+  import { componentMessage } from '../i18n/componentCatalog';
+  import type { WorkspaceLanguage } from './workspaceI18n';
+  export let initialBoardMask: bigint;
+  export let stageOneBoardMask: bigint;
+  export let targetBoardMask: bigint;
+  export let height: number;
+  export let language: WorkspaceLanguage;
+  export let disabled = false;
+  type Field = 'initialBoardMask' | 'stageOneBoardMask' | 'targetBoardMask';
+  const fields = [
+    { key: 'initialBoardMask', label: 'recoveryInitialField', color: '#454545' },
+    { key: 'stageOneBoardMask', label: 'recoveryStageOneField', color: '#939393' },
+    { key: 'targetBoardMask', label: 'recoveryTargetField', color: '#d8d8d8' }
+  ] as const;
+  let selected: Field = 'initialBoardMask';
+  const dispatch = createEventDispatcher<{ change: { field: Field; mask: bigint; height: number } }>();
+  $: masks = { initialBoardMask, stageOneBoardMask, targetBoardMask };
+  $: selectedField = fields.find(field => field.key === selected)!;
+  $: previewLayers = fields.map(field => ({ mask: masks[field.key], color: field.color, label: componentMessage(language, field.label) }));
+  function change(mask: bigint, importedHeight = height) {
+    if (!disabled) dispatch('change', { field: selected, mask, height: importedHeight });
+  }
+</script>
+
+<fieldset class="recovery-layer-editor" {disabled}>
+  <legend>{componentMessage(language, 'recoveryFieldLayers')}</legend>
+  <div class="field-segments" role="group" aria-label={componentMessage(language, 'recoveryFieldLayers')}>
+    {#each fields as field}
+      <button type="button" aria-pressed={selected === field.key} class:active={selected === field.key}
+        data-recovery-field={field.key} on:click={() => selected = field.key}>
+        <span class="swatch" style:background={field.color} aria-hidden="true"></span>
+        {componentMessage(language, field.label)}
+      </button>
+    {/each}
+  </div>
+  <p>{componentMessage(language, 'recoveryFieldLayersHelp')}</p>
+  {#key selected}
+    <WorkspaceBoardEditor mode="forward" {height} existingMask={masks[selected]} targetMask={0n}
+      piecesNeeded={null} {language} {previewLayers} showStats={false} enableGlobalPaste={false}
+      labelOverride={componentMessage(language, selectedField.label)}
+      on:change={(event) => change(event.detail.existingMask)}
+      on:import={(event) => change(event.detail.existingMask, event.detail.height)} />
+  {/key}
+</fieldset>
+
+<style>
+  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
+  legend { font-size: 13px; font-weight: 750; margin-bottom: 10px; }
+  .field-segments { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 3px; padding: 3px; border-radius: 6px; background: #e9eeeb; }
+  button { display: flex; align-items: center; justify-content: center; gap: 7px; min-width: 0; min-height: 44px; border: 0; border-radius: 4px; padding: 8px; background: transparent; color: #34403c; font: inherit; font-size: 12px; cursor: pointer; word-break: keep-all; }
+  button.active { background: white; box-shadow: 0 1px 3px #17211e1c; font-weight: 750; }
+  button:focus-visible { outline: 2px solid #16877d; outline-offset: 1px; }
+  button:disabled { cursor: default; opacity: .5; }
+  .swatch { height: 14px; width: 14px; border: 1px solid #333; flex: 0 0 auto; }
+  p { color: #68736f; font-size: 11px; line-height: 1.6; margin: 10px 0 14px; }
+  @media (max-width: 380px) { .field-segments { grid-template-columns: 1fr; } }
+</style>
