+
+test('recovery passes three independent fields without unioning snapshots', () => {
+  const request = { ...createBoundaryRecoveryRequest(), queue: 'II', height: 4,
+    initialBoardMask: 0n, stageOneBoardMask: 0xfn, targetBoardMask: 0xffn,
+    maxEarlyPlacements: 0 };
+  assert.deepEqual(validateBoundaryRecoveryRequest(request), []);
+  const args = boundaryRecoveryArguments(request);
+  const get = flag => args[args.indexOf(flag) + 1];
+  assert.equal(BigInt(get('--initial-board-mask')), 0n);
+  assert.equal(BigInt(get('--stage-one-board-mask')), 0xfn);
+  assert.equal(BigInt(get('--target-board-mask')), 0xffn);
+  assert.deepEqual(validateBoundaryRecoveryRequest({ ...request, stageOneBoardMask: 1n << 40n }), ['board']);
+});
