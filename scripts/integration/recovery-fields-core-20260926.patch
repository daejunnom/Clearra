 }
+
+#[test]
+fn intermediate_field_is_an_exact_checkpoint_not_a_cosmetic_preview() {
+    let mut query = two_stage_query();
+    query.initial_board = Board256Mask::EMPTY;
+    query.stage_one_target = Board256Mask::from_words([0xf, 0, 0, 0]);
+    query.final_board = Board256Mask::from_words([0xff, 0, 0, 0]);
+    query.queue = vec![PieceKind::I, PieceKind::I];
+    query.max_early_placements = 0;
+    let report = query.search(&control()).unwrap();
+    assert_eq!(report.status, BoundaryRecoveryStatus::Normal);
+    assert_eq!(report.stage_one_checkpoint_step, Some(1));
+    assert_eq!(report.checkpoint_is_pc, Some(false));
+    assert_eq!(report.steps[0].board_after, [0xf, 0, 0, 0]);
+    assert_eq!(report.steps[1].board_after, [0xff, 0, 0, 0]);
+    query.stage_one_target = Board256Mask::EMPTY;
+    assert_eq!(query.search(&control()).unwrap().status, BoundaryRecoveryStatus::NoPath);
+    query.stage_one_target = Board256Mask::from_words([1, 0, 0, 0]);
+    assert_eq!(query.search(&control()).unwrap().status, BoundaryRecoveryStatus::NoPath);
+}
+
+#[test]
+fn intermediate_field_uses_the_same_height_bound_as_initial_and_final() {
+    let mut query = two_stage_query();
+    query.stage_one_target = Board256Mask::from_words([1_u64 << 40, 0, 0, 0]);
+    assert_eq!(query.search(&control()).unwrap_err(), BoundaryRecoveryError::BoardOutsideField);
+}
diff --git a/crates/clearra-wasm/tests/boundary_field_contract.rs b/crates/clearra-wasm/tests/boundary_field_contract.rs
new file mode 100644
index 0000000..fc66c5b
--- /dev/null
+++ b/crates/clearra-wasm/tests/boundary_field_contract.rs
@@ -0,0 +1,33 @@
+#![cfg(not(target_arch = "wasm32"))]
+use clearra_host_contract::{AppStatus, ProductResultPayloadContent};
+use clearra_wasm::{WasmCommandRuntime, WasmHostCapabilities};
+
+#[test]
+fn three_boundary_fields_reach_the_real_cli_app_and_wasm_runtime() {
+    std::thread::Builder::new().stack_size(16 * 1024 * 1024).spawn(|| {
+        let runtime = WasmCommandRuntime::default()
+            .with_host_capabilities(WasmHostCapabilities::new(1, false, false));
+        for (middle, status, checkpoint) in [
+            (" --stage-one-board-mask 0xf", "normal", Some(false)),
+            (" --stage-one-board-mask 0", "no-path-within-declared-scope", None),
+            ("", "no-path-within-declared-scope", None),
+        ] {
+            let result = runtime.run_command_text(&format!(
+                "clearra recovery boundary --initial-board-mask 0 --target-board-mask 0xff \
+                 --height 4 --queue II --stage-one-count 1 --placements 2 \
+                 --max-early-placements 0 --borrow-role-position 2 --no-hold{middle}"
+            )).unwrap();
+            assert_eq!(result.app_response().status(), AppStatus::Success);
+            let ProductResultPayloadContent::BoundaryRecovery(report) =
+                result.app_response().product_result_payload().unwrap().content() else {
+                panic!("typed recovery result required");
+            };
+            assert_eq!(report.status, status);
+            assert_eq!(report.checkpoint_is_pc, checkpoint);
+            if checkpoint.is_some() {
+                assert_eq!(report.steps.len(), 2);
+                assert_eq!(report.stage_one_checkpoint_step, Some(1));
+            }
+        }
+    }).unwrap().join().unwrap();
+}
