#!/bin/sh

set -eu
umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

current_link=/opt/clearra/current
settings_path=/etc/clearra-gateway/settings
service_name=clearra-gateway.service
lock_path=/run/lock/clearra-oracle-release-deploy.lock
canonical_launcher=/usr/local/sbin/clearra-oracle-release-deploy
canonical_digester=/usr/local/libexec/clearra-release-tree-digest

source_commit=
freeze_nonce=
self_sha256=
self_path=
remote_overlay_archive=
remote_overlay_sha256=
overlay_path=
upload_root=
freeze_root=
baseline_current_raw=
baseline_current_resolved=
baseline_current_link_metadata=
baseline_active_metadata=
baseline_settings_metadata=
baseline_settings_sha256=
baseline_service_active=
baseline_service_sub=
baseline_service_pid=
baseline_service_invocation=
baseline_service_restarts=
baseline_service_cwd=
baseline_config_path=
success=0

fail() {
  /usr/bin/printf '%s\n' 'oracle_freeze=failed' >&2
  exit "${1:-1}"
}

is_sha256() {
  value=$1
  [ "${#value}" -eq 64 ] || return 1
  case "$value" in *[!0-9a-f]* ) return 1 ;; esac
}

is_source_commit() {
  value=$1
  [ "${#value}" -eq 40 ] || return 1
  case "$value" in *[!0-9a-f]* ) return 1 ;; esac
}

sha256_of() {
  /usr/bin/sha256sum -- "$1" | /usr/bin/cut -d ' ' -f 1
}

copy_remote_overlay() {
  source_path=$1
  expected_sha256=$2
  destination_path=$3
  /usr/bin/python3 - "$source_path" "$expected_sha256" "$destination_path" <<'PY'
import hashlib
import os
import stat
import sys

source, expected, destination = sys.argv[1:]
test_root = os.environ.get("CLEARRA_REMOTE_OVERLAY_TEST_ROOT") if os.geteuid() != 0 else None
authority_uid = os.geteuid() if test_root else 0
authority_gid = os.getegid() if test_root else 0
sealed_root = test_root or "/opt/clearra/sealed-release-inputs"
canonical = f"{sealed_root}/private-overlay-no-config-{expected}.tar"
if len(expected) != 64 or any(c not in "0123456789abcdef" for c in expected):
    raise SystemExit(2)
if source != canonical or os.path.dirname(destination) == "":
    raise SystemExit(2)

parent_paths = [test_root] if test_root else []
if not test_root:
    current = "/"
    for component in source.strip("/").split("/")[:-1]:
        current = os.path.join(current, component)
        parent_paths.append(current)
for current in parent_paths:
    metadata = os.lstat(current)
    if (not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != authority_uid or metadata.st_gid != authority_gid
            or stat.S_IMODE(metadata.st_mode) & 0o022):
        raise SystemExit(2)

source_fd = destination_fd = None
created = False
try:
    source_fd = os.open(source, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    metadata = os.fstat(source_fd)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != authority_uid
            or metadata.st_gid != authority_gid or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1 or metadata.st_size <= 0):
        raise OSError("sealed overlay metadata rejected")
    if test_root and os.environ.get("CLEARRA_REMOTE_OVERLAY_TEST_SWAP") == "1":
        os.replace(source + ".swap", source)
    digest = hashlib.sha256()
    while True:
        chunk = os.read(source_fd, 1024 * 1024)
        if not chunk:
            break
        digest.update(chunk)
    if digest.hexdigest() != expected:
        raise OSError("sealed overlay digest rejected")
    os.lseek(source_fd, 0, os.SEEK_SET)
    destination_fd = os.open(destination,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    created = True
    while True:
        chunk = os.read(source_fd, 1024 * 1024)
        if not chunk:
            break
        view = memoryview(chunk)
        while view:
            written = os.write(destination_fd, view)
            view = view[written:]
    os.fsync(destination_fd)
    os.close(destination_fd)
    destination_fd = None
    if test_root and os.environ.get("CLEARRA_REMOTE_OVERLAY_TEST_CORRUPT_COPY") == "1":
        with open(destination, "ab") as corrupt_copy:
            corrupt_copy.write(b"drift")
    destination_fd = os.open(destination, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    copied = os.fstat(destination_fd)
    if (not stat.S_ISREG(copied.st_mode) or copied.st_uid != authority_uid or copied.st_gid != authority_gid
            or stat.S_IMODE(copied.st_mode) != 0o600 or copied.st_nlink != 1
            or copied.st_size != metadata.st_size):
        raise OSError("copied overlay metadata rejected")
    digest = hashlib.sha256()
    while True:
        chunk = os.read(destination_fd, 1024 * 1024)
        if not chunk:
            break
        digest.update(chunk)
    if digest.hexdigest() != expected:
        raise OSError("copied overlay digest rejected")
except BaseException:
    if created:
        try:
            os.unlink(destination)
        except FileNotFoundError:
            pass
    raise
finally:
    if source_fd is not None:
        os.close(source_fd)
    if destination_fd is not None:
        os.close(destination_fd)
PY
}

require_root_regular_mode() {
  path=$1
  mode=$2
  [ -f "$path" ] && [ ! -L "$path" ] || fail 77
  [ "$(/usr/bin/stat -c '%u:%g:%a' -- "$path")" = "0:0:$mode" ] || fail 77
}

require_upload_regular_mode() {
  path=$1
  mode=$2
  [ -f "$path" ] && [ ! -L "$path" ] || fail 77
  [ "$(/usr/bin/stat -c '%u:%g:%a' -- "$path")" = "1001:1001:$mode" ] || fail 77
}

metadata_digest() {
  /usr/bin/python3 - "$1" <<'PY'
import hashlib
import os
import stat
import sys

root = os.path.realpath(sys.argv[1])
if not os.path.isdir(root) or os.path.islink(root):
    raise SystemExit(2)
entries = []
for directory, names, files in os.walk(root, topdown=True, followlinks=False):
    names.sort()
    files.sort()
    for name in names + files:
        path = os.path.join(directory, name)
        relative = os.path.relpath(path, root).replace(os.sep, "/")
        metadata = os.lstat(path)
        if stat.S_ISLNK(metadata.st_mode):
            kind, extra = "symlink", os.readlink(path)
        elif stat.S_ISDIR(metadata.st_mode):
            kind, extra = "directory", ""
        elif stat.S_ISREG(metadata.st_mode):
            kind, extra = "file", str(metadata.st_size)
        else:
            raise SystemExit(2)
        entries.append((relative, kind, metadata.st_uid, metadata.st_gid,
                        stat.S_IMODE(metadata.st_mode), extra))
digest = hashlib.sha256(b"clearra-release-metadata-v1\0")
for entry in sorted(entries):
    digest.update("\0".join(map(str, entry)).encode("utf-8"))
    digest.update(b"\0")
print(digest.hexdigest())
PY
}

capture_baseline() {
  [ -L "$current_link" ] || fail 77
  baseline_current_raw=$(/usr/bin/readlink -- "$current_link") || fail 77
  baseline_current_resolved=$(/usr/bin/readlink -f -- "$current_link") || fail 77
  [ -d "$baseline_current_resolved" ] && [ ! -L "$baseline_current_resolved" ] || fail 77
  case "$baseline_current_resolved" in /opt/clearra/releases/* ) ;; * ) fail 77 ;; esac
  release_basename=$(/usr/bin/basename -- "$baseline_current_resolved") || fail 77
  /usr/bin/printf '%s\n' "$release_basename" | /usr/bin/grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+-[0-9a-f]{7}$' || fail 77
  baseline_current_link_metadata=$(/usr/bin/stat -c '%d:%i:%u:%g:%a' -- "$current_link") || fail 77
  baseline_active_metadata=$(metadata_digest "$baseline_current_resolved") || fail 65

  [ -f "$settings_path" ] && [ ! -L "$settings_path" ] || fail 77
  baseline_settings_metadata=$(/usr/bin/stat -c '%d:%i:%u:%g:%a:%s' -- "$settings_path") || fail 77
  case "$baseline_settings_metadata" in *:0:0:600:[1-9]* | *:0:0:600:0 ) ;; * ) fail 77 ;; esac
  baseline_settings_sha256=$(sha256_of "$settings_path") || fail 65

  baseline_service_active=$(/usr/bin/systemctl show --property ActiveState --value "$service_name") || fail 69
  baseline_service_sub=$(/usr/bin/systemctl show --property SubState --value "$service_name") || fail 69
  baseline_service_pid=$(/usr/bin/systemctl show --property MainPID --value "$service_name") || fail 69
  baseline_service_invocation=$(/usr/bin/systemctl show --property InvocationID --value "$service_name") || fail 69
  baseline_service_restarts=$(/usr/bin/systemctl show --property NRestarts --value "$service_name") || fail 69
  [ "$baseline_service_active" = active ] && [ "$baseline_service_sub" = running ] || fail 69
  case "$baseline_service_pid" in '' | *[!0-9]* | 0 | 1 ) fail 69 ;; esac
  case "$baseline_service_invocation" in '' | *[!0-9a-f]* ) fail 69 ;; esac
  [ "${#baseline_service_invocation}" -eq 32 ] || fail 69
  case "$baseline_service_restarts" in '' | *[!0-9]* ) fail 69 ;; esac
  baseline_service_cwd=$(/usr/bin/readlink -f -- "/proc/$baseline_service_pid/cwd") || fail 69
  [ "$baseline_service_cwd" = "$baseline_current_resolved/apps/clearra-discord-bot" ] || fail 69

  baseline_config_path=$baseline_current_resolved/apps/clearra-discord-bot/src/admin/config.mjs
  require_root_regular_mode "$baseline_config_path" 644
}

require_baseline_unchanged() {
  [ -L "$current_link" ] || fail 73
  [ "$(/usr/bin/readlink -- "$current_link")" = "$baseline_current_raw" ] || fail 73
  [ "$(/usr/bin/readlink -f -- "$current_link")" = "$baseline_current_resolved" ] || fail 73
  [ "$(/usr/bin/stat -c '%d:%i:%u:%g:%a' -- "$current_link")" = "$baseline_current_link_metadata" ] || fail 73
  [ "$(metadata_digest "$baseline_current_resolved")" = "$baseline_active_metadata" ] || fail 73
  [ -f "$settings_path" ] && [ ! -L "$settings_path" ] || fail 73
  [ "$(/usr/bin/stat -c '%d:%i:%u:%g:%a:%s' -- "$settings_path")" = "$baseline_settings_metadata" ] || fail 73
  [ "$(sha256_of "$settings_path")" = "$baseline_settings_sha256" ] || fail 73
  [ "$(/usr/bin/systemctl show --property ActiveState --value "$service_name")" = "$baseline_service_active" ] || fail 73
  [ "$(/usr/bin/systemctl show --property SubState --value "$service_name")" = "$baseline_service_sub" ] || fail 73
  [ "$(/usr/bin/systemctl show --property MainPID --value "$service_name")" = "$baseline_service_pid" ] || fail 73
  [ "$(/usr/bin/systemctl show --property InvocationID --value "$service_name")" = "$baseline_service_invocation" ] || fail 73
  [ "$(/usr/bin/systemctl show --property NRestarts --value "$service_name")" = "$baseline_service_restarts" ] || fail 73
  [ "$(/usr/bin/readlink -f -- "/proc/$baseline_service_pid/cwd")" = "$baseline_service_cwd" ] || fail 73
  require_root_regular_mode "$baseline_config_path" 644
}

validate_layers() {
  /usr/bin/python3 - \
    "$upload_root/source.tar.gz" \
    "$overlay_path" \
    "$upload_root/ctk3-dist.tar" \
    "$upload_root/node_modules.tar" <<'PY'
import posixpath
import sys
import tarfile

overlay = {
    "apps/clearra-discord-bot/src/admin",
    "apps/clearra-discord-bot/src/admin/access-runtime.mjs",
    "apps/clearra-discord-bot/src/admin/command-identity.mjs",
    "apps/clearra-discord-bot/src/admin/discord-history-hydrator.mjs",
    "apps/clearra-discord-bot/src/admin/discord-observer.mjs",
    "apps/clearra-discord-bot/src/admin/document.mjs",
    "apps/clearra-discord-bot/src/admin/identity.mjs",
    "apps/clearra-discord-bot/src/admin/local-publisher.mjs",
    "apps/clearra-discord-bot/src/admin/main.mjs",
    "apps/clearra-discord-bot/src/admin/oracle-telemetry.conf",
    "apps/clearra-discord-bot/src/admin/oracle-usage-tracker.mjs",
    "apps/clearra-discord-bot/src/admin/runtime-extension.mjs",
    "apps/clearra-discord-bot/src/admin/server.mjs",
    "apps/clearra-discord-bot/src/admin/slash-runtime.mjs",
    "apps/clearra-discord-bot/src/admin/TELEMETRY-OPERATIONS.md",
    "apps/clearra-discord-bot/src/admin/usage-store.mjs",
    "apps/clearra-discord-bot/src/admin/telemetry",
    "apps/clearra-discord-bot/src/admin/telemetry/hmac.mjs",
    "apps/clearra-discord-bot/src/admin/telemetry/rate-limiter.mjs",
    "apps/clearra-discord-bot/src/admin/telemetry/schema.mjs",
    "apps/clearra-discord-bot/src/admin/deploy",
    "apps/clearra-discord-bot/src/admin/deploy/ORACLE_GATEWAY.md",
    "apps/clearra-discord-bot/src/admin/deploy/oracle",
    "apps/clearra-discord-bot/src/admin/deploy/oracle/clearra-gateway-vault-run",
    "apps/clearra-discord-bot/src/admin/deploy/oracle/clearra-gateway.service",
}
expected_links = {
    "node_modules/ctk3": "../packages/ctk3",
    "node_modules/@clearra/discord-bot": "../../apps/clearra-discord-bot",
}
layers = (("source", sys.argv[1]), ("overlay", sys.argv[2]),
          ("dist", sys.argv[3]), ("dependencies", sys.argv[4]))
all_entries = {}
observed_links = {}
results = []
for label, archive_path in layers:
    counts = {"file": 0, "directory": 0, "symlink": 0}
    layer_entries = {}
    with tarfile.open(archive_path, "r:*") as archive:
        for member in archive:
            name = member.name.rstrip("/")
            if (not name or name.startswith("/") or "\\" in name or
                    posixpath.normpath(name) != name or name == ".." or
                    name.startswith("../")):
                raise SystemExit(2)
            if label == "overlay" and name not in overlay:
                raise SystemExit(2)
            if label == "dist" and not (name == "packages/ctk3/dist" or
                    name.startswith("packages/ctk3/dist/")):
                raise SystemExit(2)
            if label == "dependencies" and not (
                    name in {"node_modules", "node_modules/@clearra",
                             "node_modules/ctk3", "node_modules/@clearra/discord-bot",
                             "node_modules/tetris-fumen"} or
                    name.startswith("node_modules/tetris-fumen/")):
                raise SystemExit(2)
            if name in layer_entries or name in all_entries:
                raise SystemExit(2)
            if member.isfile():
                kind = "file"
            elif member.isdir():
                kind = "directory"
            elif member.issym():
                kind = "symlink"
                target = member.linkname
                resolved = posixpath.normpath(posixpath.join(posixpath.dirname(name), target))
                if (not target or target.startswith("/") or "\\" in target or
                        resolved == ".." or resolved.startswith("../")):
                    raise SystemExit(2)
                observed_links[name] = target
            else:
                raise SystemExit(2)
            layer_entries[name] = kind
            counts[kind] += 1
    if label == "overlay" and set(layer_entries) != overlay:
        raise SystemExit(2)
    all_entries.update(layer_entries)
    results.extend((counts["file"], counts["directory"], counts["symlink"]))
for name, kind in all_entries.items():
    parent = posixpath.dirname(name)
    while parent:
        parent_kind = all_entries.get(parent)
        if parent_kind is not None and parent_kind != "directory":
            raise SystemExit(2)
        parent = posixpath.dirname(parent)
if observed_links != expected_links:
    raise SystemExit(2)
if "apps/clearra-discord-bot/src/admin/config.mjs" in all_entries:
    raise SystemExit(2)
print(":".join(map(str, results)))
PY
}

validate_candidate() {
  root=$1
  [ -d "$root" ] && [ ! -L "$root" ] || fail 77
  [ "$(/usr/bin/stat -c '%u:%g:%a' -- "$root")" = '0:0:755' ] || fail 77
  unsafe=$(/usr/bin/find "$root" -xdev \( -type f -o -type d -o -type l \) \( ! -user root -o ! -group root \) -print -quit) || fail 77
  [ -z "$unsafe" ] || fail 77
  unsupported=$(/usr/bin/find "$root" -xdev ! -type f ! -type d ! -type l -print -quit) || fail 77
  [ -z "$unsupported" ] || fail 77
  writable=$(/usr/bin/find "$root" -xdev \( -type f -o -type d \) -perm /022 -print -quit) || fail 77
  [ -z "$writable" ] || fail 77
  bad_directories=$(/usr/bin/find "$root" -xdev -type d ! -perm 0755 -print -quit) || fail 77
  [ -z "$bad_directories" ] || fail 77
  bad_files=$(/usr/bin/find "$root" -xdev -type f ! -perm 0644 ! -perm 0755 -print -quit) || fail 77
  [ -z "$bad_files" ] || fail 77
  [ -L "$root/node_modules/ctk3" ] || fail 77
  [ "$(/usr/bin/readlink -- "$root/node_modules/ctk3")" = '../packages/ctk3' ] || fail 77
  [ -L "$root/node_modules/@clearra/discord-bot" ] || fail 77
  [ "$(/usr/bin/readlink -- "$root/node_modules/@clearra/discord-bot")" = '../../apps/clearra-discord-bot' ] || fail 77
  require_root_regular_mode "$root/apps/clearra-discord-bot/src/admin/config.mjs" 644
}

assemble_candidate() {
  root=$1
  release_id=$2
  [ ! -e "$root" ] && [ ! -L "$root" ] || fail 73
  /usr/bin/mkdir -m 0755 -- "$root"
  /usr/bin/tar --extract --gzip --no-same-owner --file="$upload_root/source.tar.gz" --directory="$root"
  /usr/bin/tar --extract --no-same-owner --file="$overlay_path" --directory="$root"
  /usr/bin/tar --extract --no-same-owner --file="$upload_root/ctk3-dist.tar" --directory="$root"
  /usr/bin/tar --extract --no-same-owner --file="$upload_root/node_modules.tar" --directory="$root"
  /usr/bin/install -o root -g root -m 0644 -- "$baseline_config_path" "$root/apps/clearra-discord-bot/src/admin/config.mjs"
  for normalize_root in \
    "$root/apps/clearra-discord-bot/src/admin" \
    "$root/apps/clearra-discord-bot/test" \
    "$root/packages/ctk3/dist" \
    "$root/node_modules"
  do
    /usr/bin/find "$normalize_root" -xdev -type d -exec /usr/bin/chmod 0755 -- {} +
    /usr/bin/find "$normalize_root" -xdev -type f -exec /usr/bin/chmod 0644 -- {} +
  done
  /usr/bin/chown -hR root:root -- "$root"
  /usr/bin/chmod 0755 -- \
    "$root/scripts/tools/package-release-cli.sh" \
    "$root/apps/clearra-discord-bot/scripts/capture-oracle-rollback-authority.mjs" \
    "$root/apps/clearra-discord-bot/scripts/produce-oracle-deployment-proof.mjs" \
    "$root/apps/clearra-discord-bot/scripts/release-tree-digest.mjs" \
    "$root/apps/clearra-discord-bot/scripts/restore-oracle-release" \
    "$root/apps/clearra-discord-bot/scripts/verify-oracle-candidate-proof.mjs" \
    "$root/apps/clearra-discord-bot/scripts/verify-oracle-rollback-proof.mjs" \
    "$root/apps/clearra-discord-bot/src/admin/deploy/oracle/clearra-gateway-vault-run"
  validate_candidate "$root"
}

tool_authority() {
  current_sha256=$1
  path=$2
  if [ -e "$path" ] || [ -L "$path" ]; then
    require_root_regular_mode "$path" 755
    installed_sha256=$(sha256_of "$path")
    if [ "$installed_sha256" = "$current_sha256" ]; then
      /usr/bin/printf '%s\n' 'absent:0'
    else
      /usr/bin/printf '%s:%s\n' "$installed_sha256" "$(/usr/bin/stat -c '%s' -- "$path")"
    fi
  else
    /usr/bin/printf '%s\n' 'absent:0'
  fi
}

cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$freeze_root" ]; then
    case "$freeze_root" in /opt/clearra/.v080-freeze-* )
      if [ -d "$freeze_root" ] && [ ! -L "$freeze_root" ]; then
        /usr/bin/rm -rf -- "$freeze_root" || status=74
      fi
      ;;
    esac
  fi
  if [ "$success" -ne 1 ]; then
    /usr/bin/printf '%s\n' 'oracle_freeze=failed' >&2
  fi
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

while [ "$#" -gt 0 ]; do
  case "$1" in
    --source-commit) [ "$#" -ge 2 ] && [ -z "$source_commit" ] || fail 64; source_commit=$2; shift 2 ;;
    --nonce) [ "$#" -ge 2 ] && [ -z "$freeze_nonce" ] || fail 64; freeze_nonce=$2; shift 2 ;;
    --self-sha256) [ "$#" -ge 2 ] && [ -z "$self_sha256" ] || fail 64; self_sha256=$2; shift 2 ;;
    --self-path) [ "$#" -ge 2 ] && [ -z "$self_path" ] || fail 64; self_path=$2; shift 2 ;;
    --remote-overlay-archive) [ "$#" -ge 2 ] && [ -z "$remote_overlay_archive" ] || fail 64; remote_overlay_archive=$2; shift 2 ;;
    --remote-overlay-sha256) [ "$#" -ge 2 ] && [ -z "$remote_overlay_sha256" ] || fail 64; remote_overlay_sha256=$2; shift 2 ;;
    *) fail 64 ;;
  esac
done

is_source_commit "$source_commit" || fail 64
is_sha256 "$freeze_nonce" || fail 64
is_sha256 "$self_sha256" || fail 64
if [ -n "$remote_overlay_archive" ] || [ -n "$remote_overlay_sha256" ]; then
  is_sha256 "$remote_overlay_sha256" || fail 64
  [ "$remote_overlay_archive" = "/opt/clearra/sealed-release-inputs/private-overlay-no-config-$remote_overlay_sha256.tar" ] || fail 64
  overlay_mode=remote
else
  overlay_mode=local
fi
commit_prefix=$(/usr/bin/printf '%.7s' "$source_commit")
release_id=v0.8.0-$commit_prefix
case "$self_path" in /usr/local/sbin/.clearra-oracle-freeze-v080-$commit_prefix.[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9] ) ;; * ) fail 64 ;; esac
[ "$(/usr/bin/readlink -f -- "$0")" = "$self_path" ] || fail 77
require_root_regular_mode "$self_path" 755
[ "$(sha256_of "$self_path")" = "$self_sha256" ] || fail 65
[ "$(/usr/bin/id -u)" -eq 0 ] || fail 77

upload_root=/home/ubuntu/.clearra-v080-freeze-$commit_prefix-$freeze_nonce
freeze_root=/opt/clearra/.v080-freeze-$commit_prefix-$freeze_nonce
[ -d "$upload_root" ] && [ ! -L "$upload_root" ] || fail 77
[ "$(/usr/bin/readlink -f -- "$upload_root")" = "$upload_root" ] || fail 77
[ "$(/usr/bin/stat -c '%u:%g:%a' -- "$upload_root")" = '1001:1001:700' ] || fail 77
if [ "$overlay_mode" = local ]; then
  unexpected=$(/usr/bin/find "$upload_root" -xdev -mindepth 1 -maxdepth 1 \
    ! -name source.tar.gz ! -name private-overlay-no-config.tar ! -name ctk3-dist.tar \
    ! -name node_modules.tar ! -name clearra-oracle-release-deploy \
    ! -name clearra-release-tree-digest.py ! -name clearra-oracle-freeze-v080 -print -quit) || fail 77
else
  unexpected=$(/usr/bin/find "$upload_root" -xdev -mindepth 1 -maxdepth 1 \
    ! -name source.tar.gz ! -name ctk3-dist.tar \
    ! -name node_modules.tar ! -name clearra-oracle-release-deploy \
    ! -name clearra-release-tree-digest.py ! -name clearra-oracle-freeze-v080 -print -quit) || fail 77
fi
[ -z "$unexpected" ] || fail 77
expected_upload_count=6
[ "$overlay_mode" = local ] && expected_upload_count=7
